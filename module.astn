(
    'omit (de)serializer': false
    'schema tree': | 'set' {
        `structure`: | 'schema' (
            'schema imports': {}
            'resolver imports': {}
            'globals': (
                'complexity': | 'unconstrained' ~
                'text types': {
                    `Text Value`: (
                        'type': | 'single line' ~
                    )
                }
                'number types': {
                    `Position`: (
                        'precision': | 'exact' (
                            'decimal separator offset': ~
                            'type': | 'natural' ~
                        )
                    )
                }
            )
            'modules': {
                `Directory`: (
                    'root value': | 'state' (
                        'options': {
                            `dictionary`: (
                                'constraints': ~
                                'description': ~
                                'value': | 'component' (
                                    'type': | 'internal' `Directory`
                                    'results': ~
                                )
                            )
                            `group`: (
                                'constraints': ~
                                'description': ~
                                'value': | 'dictionary' (
                                    'value': | 'state' (
                                        'options': {
                                            `directory`: (
                                                'constraints': ~
                                                'description': ~
                                                'value': | 'component' (
                                                    'type': | 'internal' `Directory`
                                                    'results': ~
                                                )
                                            )
                                            `file`: (
                                                'constraints': ~
                                                'description': ~
                                                'value': | 'state' (
                                                    'options': {
                                                        `manual`: (
                                                            'constraints': ~
                                                            'description': ~
                                                            'value': | 'nothing' ~
                                                        )
                                                        `generated`: (
                                                            'constraints': ~
                                                            'description': ~
                                                            'value': | 'group' {
                                                                `commit to git`: (
                                                                    'description': ~
                                                                    'value': | 'boolean' ~
                                                                )
                                                            }
                                                        )
                                                    }
                                                    'results': ~
                                                )
                                            )
                                        }
                                        'results': ~
                                    )
                                )
                            )
                            `wildcards`: (
                                'constraints': ~
                                'description': ~
                                'value': | 'group' {
                                    `required directories`: (
                                        'description': ~
                                        'value': | 'number' | 'local' (
                                            'precision': | 'exact' (
                                                'decimal separator offset': ~
                                                'type': | 'natural' ~
                                            )
                                        )
                                    )
                                    `additional directories allowed`: (
                                        'description': ~
                                        'value': | 'boolean' ~
                                    )
                                    `extensions`: (
                                        'description': ~
                                        'value': | 'list' (
                                            'value': | 'text' | 'local' (
                                                'type': | 'single line' ~
                                            )
                                            'results': ~
                                        )
                                    )
                                    `warn`: (
                                        'description': ~
                                        'value': | 'boolean' ~
                                    )
                                }
                            )
                            `freeform`: (
                                'constraints': ~
                                'description': ~
                                'value': | 'nothing' ~
                            )
                            `ignore`: (
                                'constraints': ~
                                'description': ~
                                'value': | 'nothing' ~
                            )
                            `generated`: (
                                'constraints': ~
                                'description': ~
                                'value': | 'group' {
                                    `commit to git`: (
                                        'description': ~
                                        'value': | 'boolean' ~
                                    )
                                }
                            )
                        }
                        'results': ~
                    )
                )
            }
            'complexity': | 'unconstrained' ~
        )
    }
)
